# ─── Aplicación ───
NODE_ENV=production
PORT=3000
AUTO_BOOTSTRAP=true

# ─── Autenticación ───
API_KEY=
SECRET=
RECOVERY_SECRET=

# ─── Correo (recuperación de contraseña, notificaciones) ───
EMAIL=
PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true

# ─── CORS / Frontend ───
CORS_ORIGIN=
FRONTEND_URL=

# ─── Usuario admin inicial (bootstrap) ───
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@banarica.local
SEED_ADMIN_PASSWORD=

# ─── Integración con api-rest-corbana ───
CORBANA_API_URL=
CORBANA_API_KEY=

# ─── Base de datos: producción ───
# DATABASE_HOST NO debe ser localhost/127.0.0.1 cuando la API corre en
# Docker y MySQL también está en un contenedor — debe ser el nombre DNS del
# servicio/contenedor MySQL dentro de la red Docker de Hostinger. Si no
# conoces el nombre exacto, usa "mysql" como placeholder y corrígelo por el
# nombre real del servicio MySQL de tu proyecto en Hostinger.
DATABASE_USERNAME=
DATABASE_PASSWORD=
DATABASE_NAME=
DATABASE_HOST=mysql
DATABASE_PORT=3306

# ─── Base de datos: desarrollo ───
DATABASE_DEV_USERNAME=
DATABASE_DEV_PASSWORD=
DATABASE_DEV_NAME=
DATABASE_DEV_HOST=localhost
DATABASE_DEV_PORT=3306
