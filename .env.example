# ─── Aplicación ───
NODE_ENV=production
PORT=3000
AUTO_BOOTSTRAP=true

# ─── Autenticación ───
#API_KEY=
#SECRET=
#RECOVERY_SECRET=

# ─── Correo (recuperación de contraseña, notificaciones) ───
EMAIL=soporteapplog@gmail.com
PASSWORD=cevx bfse uygu evne
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true

# ─── CORS / Frontend ───
#CORS_ORIGIN=
#FRONTEND_URL=

# ─── Usuario admin inicial (bootstrap) ───
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@banarica.local
SEED_ADMIN_PASSWORD=

# ─── Google Drive (cargue de fotos de transporte) ───
# JSON completo de la cuenta de servicio (una sola línea, con \n escapados
# dentro de private_key) — ver services/googleDrive/cargueFotos.js.
#GOOGLE_DRIVE_CREDENTIALS=

# ─── Integración con api-rest-corbana ───
#CORBANA_API_URL=
#CORBANA_API_KEY=

# ─── Base de datos: producción ───
# DATABASE_HOST es el nombre del contenedor MySQL en la red Docker externa
# "banarica-network" del VPS de Hostinger (no localhost/127.0.0.1 — la API
# corre en un contenedor distinto al de MySQL). La API se conecta con un
# usuario de aplicación (banarica_user), nunca con root.
DATABASE_USERNAME=banarica_user
#DATABASE_PASSWORD=
DATABASE_NAME=logistica
DATABASE_HOST=banarica-mysql
DATABASE_PORT=3306

# ─── Base de datos: desarrollo ───
DATABASE_DEV_USERNAME=
DATABASE_DEV_PASSWORD=
DATABASE_DEV_NAME=
DATABASE_DEV_HOST=localhost
DATABASE_DEV_PORT=3306
